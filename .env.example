# Smadex Creative Copilot — environment variables
#
# Optional — used only when running:
#   python src/ml_pipeline_sklearn.py
# If GEMINI_API_KEY is set, the pipeline can call Gemini once per cluster to
# enrich ml_results.json with marketer-facing persona blurbs.
#
# The interactive dashboard does NOT read this file. Use Help → Save key in the
# browser so API credentials never land inside creative_copilot.html.
#
# 1. Copy:   cp .env.example .env   (macOS/Linux)   copy .env.example .env   (Windows)
# 2. Paste your Gemini API key into .env (see link below).
#
# Your .env file is listed in .gitignore and will NEVER be committed.
# Get a key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your-api-key-here
